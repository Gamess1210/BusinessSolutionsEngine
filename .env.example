# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
VITE_APP_URL=http://localhost:5173

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google (Gemini)
GOOGLE_API_KEY=your-google-api-key

# Microsoft Graph API (SharePoint upload)
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_CLIENT_ID=your-azure-app-client-id
GRAPH_CLIENT_SECRET=your-azure-app-client-secret
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_DRIVE_ID=your-sharepoint-drive-id

# Power Automate webhooks
POWER_AUTOMATE_PROPOSAL_SEND_TRIGGER_URL=https://prod-xx.westeurope.logic.azure.com/workflows/...

# Review loop
REVIEW_MAX_CYCLES=5
REVIEW_THRESHOLD_DEFAULT=7
